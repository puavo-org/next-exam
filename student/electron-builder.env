# Version
VERSION=1.1.3

# Build Number
BUILD_NUMBER=1

# Product Name
PRODUCT_NAME="Next-Exam-Puavo-Student"

# Additional Info
INFO="Release"

# Client Directory
CLIENT_DIRECTORY="EXAM-STUDENT"

# Server API Port
SERVER_API_PORT=22422

# Multicast Client Port (normally 6024, the Puavo variant uses 6034)
MULTICAST_CLIENT_PORT=6034

# Use bundled minimal JRE
USE_BUNDLED_JRE=false

# BIP Integration
BIP_INTEGRATION=false

# BIP Demo
BIP_DEMO=false

# Is Puavo Flavor
IS_PUAVO=true

# Sign and Notarize
SIGN=true

# Show Devtools
SHOWDEVTOOLS=false

# Development Mode
DEVELOPMENT=false

# Next-Exam Variant
VARIANT='puavo'
