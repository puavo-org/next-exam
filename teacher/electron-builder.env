# Version
VERSION=1.1.3

# Build Number
BUILD_NUMBER=1

# Product Name
PRODUCT_NAME="Next-Exam-Puavo-Teacher"

# Additional Info
INFO="Release"

# Client Directory
CLIENT_DIRECTORY="EXAM-TEACHER"

# Server API Port
SERVER_API_PORT=22422

# Multicast Client Port (normally 6024, the Puavo variant uses 6034)
MULTICAST_CLIENT_PORT=6034

# Multicast Server Client Port (normally 6025, the Puavo variant uses 6035)
MULTICAST_SERVER_CLIENT_PORT=6035

# BIP Integration
BIP_INTEGRATION=false

# BIP Demo
BIP_DEMO=false

# Is Puavo Flavor
IS_PUAVO=true

# Sign and Notarize
SIGN=true

# Exam Modes
EXAMMODE_RDP=true
EXAMMODE_WEBSITE=true
EXAMMODE_GFORMS=true
EXAMMODE_EDUVIDUAL=true
EXAMMODE_EDITOR=true
EXAMMODE_MATH=true
EXAMMODE_MICROSOFT365=true
EXAMMODE_ACTIVESHEETS=false

# Show Devtools
SHOWDEVTOOLS=false

# Development Mode
DEVELOPMENT=false

# Next-Exam Variant
VARIANT='puavo'

